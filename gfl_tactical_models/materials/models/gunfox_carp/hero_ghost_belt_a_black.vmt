"VertexLitGeneric"
{
    "$basetexture" "models/gunfox_carp/hero_ghost_belt_a_black_rgb"


    /////////////////
    "$color2" "[0.83 0.83 0.83]"                                     //do not touch this
    "$blendtintbybasealpha" "1"                             //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "1"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "models/gunfox_carp/specularity_50"
    "$envmaptint" "[0.133 0.129 0.118]"                 

    //remove this if not using MWB
    "Proxies"
    {
        "MwEnvMapTint"
        {
            "min" "0"
            "max" "1"
            "envmap" "models/gunfox_carp/specularity_50"
            "color" "[0.133 0.129 0.118]"
        }
    }
}