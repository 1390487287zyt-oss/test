	$POWERFUNCTION "[0.8 2.5 5]"
	
	$OVERBRIGHTFACTOR 3.5
//	$EXTRACTGREENALPHA 1
	$ADDSELF 1.0
//	$DEPTHBLEND 1
//	$startfadesize .2
//	$endfadesize .25
//	$MAXSIZE .25
	$BLENDFRAMES 1
}
