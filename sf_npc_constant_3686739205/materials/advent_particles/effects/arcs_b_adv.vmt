"SpriteCard"
{
	"$basetexture" "advent_particles\effects/arcs_b_adv"
	
	// Property of HoovyTube. Now, return to the grind.
	$ADDOVERBLEND 1
	
// RAMPTEXTURE and POWERFUNCTION are mutually exclusive:	
