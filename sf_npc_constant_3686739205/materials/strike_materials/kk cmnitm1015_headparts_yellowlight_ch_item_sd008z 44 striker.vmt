VertexLitGeneric
{
	$basetexture "Strike_materials/KK cmnitm1015_headparts_yellowlight_CH_ITEM_SD008Z 44 Striker"
	$bumpmap "strike_materials/an"

	$lightwarptexture "strike_materials/basewarp"

	$alphatest 1
	$nocull 1

	$phong 1
	$phongexponenttexture "strike_materials/_phong_exp"
	$phongfresnelranges "[1 0.1 0.1]"
	$halflambert 1
	$phongalbedotint 1
	$phongboost 0.02

	$nodecal 1

	$allowalphatocoverage 1
	$model 1


	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedTextureVar" 			"$basetexture" //What to animate. Can also be $detail and $bumpmap
			"animatedTextureFrameNumVar"	"$frame"
			"animatedTextureFrameRate" 		"30" //FPS HERE
		}
	}
}