"VertexlitGeneric"
{


"$basetexture" "Borderlands 3/maliwan/wotanshield/T_FX_HexPattern_Ctest2"
"$bumpmap" "Borderlands 3/maliwan/wotanshield/T_FX_HexPattern_N"


"$surfaceprop" "flesh"


"$translucent" "1"
"$nocull" 1
"$halflambert" 1
"$phong" "1"
"$phongexponent" "20"
"$phongboost" "1"	
"$phongfresnelranges"	"[.3 1 7]"

"Proxies"
{
"TextureScroll"
{
"texturescrollvar" "$baseTextureTransform"
"texturescrollrate" "0.05"
"texturescrollangle" "-330"
}
}
 "$detail" "Borderlands 3/maliwan/wotanshield/T_FX_HexPattern_Ctest2"
 "$detailscale" "8"        //scales the detail texture to same size as diffuse.
 "$detailblendfactor" "1"  //lower values make the texture less visible. 0.0 - 1.0
 "$detailblendmode" "5"    //6 also works.
"$detailtint"  "{0 200 250 }"

}